# Attendance - environment template.
# Copy to .env locally or on the server. Never commit real secrets.
#
# Local defaults target Laravel Herd + MySQL 8 with database-backed sessions
# and cache, and no queue worker. See README.md for setup and DEPLOYMENT.md
# for the production checklist.

APP_NAME=Attendance
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://attendance.test

# Arabic interface by default; set en for English. Every user-facing string
# exists in both lang/ar and lang/en, and English is the fallback.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Official attendance time. Attendance timestamps and the attendance day are
# always computed in this timezone on the server, never on the device.
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance
DB_USERNAME=attendance
DB_PASSWORD=attendance
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Attendance rules. The company coordinates and the allowed radius are NOT
# environment values: an administrator sets them in the admin panel and they
# live in the attendance_settings table (default radius 150 m). Only the
# accuracy ceiling is tuned here - readings looser than this many metres are
# refused with a request to enable precise location.
ATTENDANCE_MAX_ACCURACY_METERS=100

# Optional bootstrap administrator, created by `php artisan db:seed` when
# both email and password are set. Prefer `php artisan app:create-admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production behind HTTPS:
# SESSION_SECURE_COOKIE=true

# No queued work exists in this application: sync needs no worker process.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No mail is sent by the application today. Kept on the log driver so a
# future notification never fails at boot.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production checklist (set on the server only - not in Git)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://attendance.your-company.example
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# See DEPLOYMENT.md for the full first-time server setup.
