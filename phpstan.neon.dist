includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 is where the codebase stands clean. Raise it deliberately, one
    # level at a time, fixing what each new level surfaces - never by adding
    # ignore entries.
    level: 5

    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Larastan resolves model properties, relations and container bindings
    # by booting the application. Without this every Eloquent magic property
    # is reported as undefined and buries the real findings.
    bootstrapFiles:
        - vendor/autoload.php

    # Model attributes are checked against the database schema. Enum-cast
    # attributes therefore carry @property annotations on the model, since
    # the schema only knows they are strings.
    checkModelProperties: true

    # By default PHPStan remembers the result of a possibly-impure call and
    # assumes a second identical call returns the same value. In a test
    # suite that is exactly backwards: asserting on a query helper, mutating
    # state, then asserting on the same helper again is the shape of half
    # the tests here, and the default flags the second assertion as already
    # proven. Off, so a repeated call is re-inferred rather than remembered.
    rememberPossiblyImpureFunctionValues: false
